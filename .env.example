# Server Configuration
PORT=3000

# Token Refresh Configuration (in milliseconds)
# How often tokens should be refreshed automatically (default: 30 minutes = 1800000 ms)
REFRESH_INTERVAL=1800000

# Target Endpoint Configuration
# Where to automatically push the generated tokens (e.g. DayNight / Lavalink v4 endpoint)
TARGET_ENDPOINT_URL=http://localhost:2333/youtube

# Optional Authorization secret / password sent in Authorization header
TARGET_ENDPOINT_AUTH=youshallnotpass
